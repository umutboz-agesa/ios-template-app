// ── FLAVOR: prd (production) ──
SABANCIM_FLAVOR = prd
BUNDLE_ID = com.agesa.template
SABANCIM_DISPLAY_NAME = iOSTemplate

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Backend adresi — .xcconfig'ten okunur (bkz. NetworkEnvironment.swift).
// NOT: xcconfig'te "//" HER ZAMAN yorum başlatır — tırnak içine alsanız BİLE
// (Xcode'un ayrıştırıcısı yorum şeridini tırnaktan önce keser). Çözüm: iki
// slash'ın arasına boş bir makro (`$()`) koymak — genişleyince yine "//" olur
// ama parse anında literal "//" görünmediği için yorum sanılmaz.
API_BASE_URL = https:/$()/mobileapp.agesa.com.tr/maf-ui-bff-mobile/
